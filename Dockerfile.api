FROM python:3.12.11-slim AS runtime

ARG TORCH_VERSION=2.7.1

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN groupadd --system --gid 10001 neuralops \
    && useradd --system --uid 10001 --gid neuralops --home-dir /nonexistent neuralops

RUN python -m pip install \
      --index-url https://download.pytorch.org/whl/cpu \
      "torch==${TORCH_VERSION}"

COPY pyproject.toml README.md LICENSE ./
COPY neuralops ./neuralops
RUN python -m pip install .

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"]

ENTRYPOINT ["neuralops"]
CMD ["serve", "--artifact", "/app/artifact", "--host", "0.0.0.0", "--port", "8000", "--device", "cpu"]
